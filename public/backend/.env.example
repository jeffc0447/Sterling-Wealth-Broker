# =====================================================================
# Sterling Wealth Brokerage — cPanel PHP & MySQL .env Template
# Production Domain: investproasset.com
#
# HOW TO USE ON CPANEL:
# 1. Copy or rename this file to `.env` inside `public_html/backend/.env`
#    (or place it at `public_html/.env` or `/home/<cpanel_user>/.env`).
# 2. Create your MySQL Database & User in cPanel -> MySQL Databases.
# 3. Replace DB_NAME, DB_USER, and DB_PASS with your cPanel credentials.
# 4. Run https://investproasset.com/backend/api/setup_check.php to verify.
# =====================================================================

# Application Environment
APP_ENV="production"
APP_DEBUG="false"
APP_TIMEZONE="UTC"

# Production Domain & CORS Origins
SITE_DOMAIN="investproasset.com"
SITE_URL="https://investproasset.com"
ALLOWED_ORIGINS="https://investproasset.com,https://www.investproasset.com"

# cPanel MySQL / MariaDB Credentials
# Note: cPanel automatically prefixes DB names and users (e.g. cpaneluser_sterlingdb)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="investpro_sterlingdb"
DB_USER="investpro_sterlinguser"
DB_PASS="ReplaceWithYourStrongMySQLPassword"
DB_CHARSET="utf8mb4"
# Leave empty for standard TCP localhost connection; set only if your host specifies a socket
DB_SOCKET=""

# Session Token Secret (change to a random 32+ character string before going live)
AUTH_TOKEN_SECRET="replace-with-a-random-64-char-secret-key-for-cpanel-production"

# Contact Form, SMTP & Automated Email Notifications
CONTACT_RECIPIENT_EMAIL="support-broker@consultant.com"
ADMIN_ALERT_EMAIL="support-broker@consultant.com"
MAIL_DRIVER="smtp"
MAIL_FROM_EMAIL="noreply@investproasset.com"
MAIL_FROM_NAME="Sterling Wealth Broker"
SMTP_HOST="mail.investproasset.com"
SMTP_PORT="465"
SMTP_ENCRYPTION="ssl"
SMTP_USER="noreply@investproasset.com"
SMTP_PASS=""

# Institutional Customer Care Defaults
CARE_AGENT_NAME="Jeffery Dean"
CARE_AGENT_EMAIL="jeffery@accountant.com"
CARE_AGENT_SECONDARY_EMAIL="jeffery@sterlingwealthbroker.com"

