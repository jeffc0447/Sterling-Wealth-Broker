# =====================================================================
# Sterling Wealth Brokerage — Complete .env Configuration Template
# Copy to `.env` (for build/local) and `backend/.env` (for cPanel PHP & MySQL)
# =====================================================================

# --- 1. Build & Runtime Environment ---
APP_ENV="production"
APP_DEBUG="false"
APP_TIMEZONE="UTC"
APP_URL="https://investproasset.com"

# --- 2. Vite Frontend Build Variables (compiled into dist/ during npm run build) ---
VITE_SITE_DOMAIN="investproasset.com"
VITE_SITE_URL="https://investproasset.com"
VITE_PHP_BACKEND_URL="/backend/api"
VITE_CONTACT_EMAIL="support-broker@consultant.com"

# --- 3. PHP Backend Domain & CORS Origins ---
SITE_DOMAIN="investproasset.com"
SITE_URL="https://investproasset.com"
ALLOWED_ORIGINS="https://investproasset.com,https://www.investproasset.com"

# --- 4. cPanel MySQL / MariaDB Database Connection ---
# Create your database & user in cPanel -> MySQL Databases (cPanel prefixes them with your username)
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="investpro_sterlingdb"
DB_USER="investpro_sterlinguser"
DB_PASS="ReplaceWithYourStrongMySQLPassword"
DB_CHARSET="utf8mb4"
DB_SOCKET=""

# --- 5. Security & Session Signing Secret (min 32 random chars) ---
AUTH_TOKEN_SECRET="replace-with-a-random-64-char-secret-key-for-cpanel-production"

# --- 6. Contact Form, SMTP & Automated Email Notifications ---
CONTACT_RECIPIENT_EMAIL="support-broker@consultant.com"
ADMIN_ALERT_EMAIL="support-broker@consultant.com"
MAIL_DRIVER="smtp"
MAIL_FROM_EMAIL="noreply@investproasset.com"
MAIL_FROM_NAME="Sterling Wealth Broker"
SMTP_HOST="mail.investproasset.com"
SMTP_PORT="465"
SMTP_ENCRYPTION="ssl"
SMTP_USER="noreply@investproasset.com"
SMTP_PASS=""

# --- 7. Customer Care Defaults ---
CARE_AGENT_NAME="Jeff Campbell"
CARE_AGENT_EMAIL="jeff@sterlingwealthbroker.com"

